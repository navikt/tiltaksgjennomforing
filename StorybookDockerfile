FROM cgr.dev/chainguard/nginx:latest-dev AS prepare
USER root
COPY ./saksbehandler/storybook-static /usr/share/nginx/html
RUN touch /usr/share/nginx/html/isAlive /usr/share/nginx/html/isReady
COPY ./saksbehandler/storybook-nginx.conf /etc/nginx/nginx.conf
USER nginx
RUN nginx -t

FROM cgr.dev/chainguard/nginx:latest
COPY --from=prepare /usr/share/nginx/html /usr/share/nginx/html
COPY --from=prepare /etc/nginx/nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080
